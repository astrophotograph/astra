{
  "name": "astra-gallery",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "r2_buckets": [
    { "binding": "GALLERY_BUCKET", "bucket_name": "astra-gallery" }
  ],
  "kv_namespaces": [
    { "binding": "GALLERY_KV", "id": "3fc397117b7f4ab78a0d4708b413d779" }
  ],
  "d1_databases": [
    { "binding": "SOCIAL_DB", "database_name": "astra-social", "database_id": "158a56c8-6f2b-48af-854e-a83eccf01346" }
  ],
  // Downloads-only since the 2026-08 cutover: the apex DNS record points at
  // the daemon's tunnel; this zone route intercepts just /downloads/*.
  // (KV/D1 bindings above are retained read-only per the decommission plan.)
  "routes": [
    { "pattern": "astra.gallery/downloads/*", "zone_name": "astra.gallery" }
  ]
}
